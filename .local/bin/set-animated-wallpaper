#!/usr/bin/env bash
set -euo pipefail

: "${ANIMATED_WALLPAPER:=$(xdg-user-dir PICTURES)/wallpapers/lost_papers_by_kirokaze_de7226p.gif}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/animated-wallpaper"
log_file="$state_dir/mpv.log"
mkdir -p "$state_dir"

# Stop only wallpaper instances from earlier runs.
pkill -f "xwinwrap.*mpv.*$(printf '%s' "$ANIMATED_WALLPAPER" | sed 's/[][\\.^$*+?(){}|/]/\\&/g')" 2>/dev/null || true
pkill -f "mpv.*$(printf '%s' "$ANIMATED_WALLPAPER" | sed 's/[][\\.^$*+?(){}|/]/\\&/g')" 2>/dev/null || true

if [[ ! -f "$ANIMATED_WALLPAPER" ]]; then
    notify-send --urgency=critical --icon=dialog-error \
        "Animated wallpaper not found" \
        "File not found: $ANIMATED_WALLPAPER"
    exit 1
fi

geometry="$(
    xrandr --current | awk '
        / connected primary / {
            for (i = 1; i <= NF; i++)
                if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
                    print $i
                    exit
                }
        }
        / connected / && fallback == "" {
            for (i = 1; i <= NF; i++)
                if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/)
                    fallback = $i
        }
        END {
            if (fallback != "") print fallback
        }'
)"

if [[ -z "$geometry" ]]; then
    notify-send --urgency=critical "Animated wallpaper" \
        "Could not determine monitor geometry."
    exit 1
fi

: > "$log_file"

xwinwrap -g "$geometry" \
    -ni -nf -b -sp -st -s -un -fs -fdt -argb -d -- \
    mpv \
        --no-config \
        --no-audio \
        --loop-file=inf \
        --vo=gpu \
        --gpu-context=x11egl \
        --hwdec=no \
        --x11-present=no \
        --x11-bypass-compositor=never \
        --scale=nearest \
        --cscale=nearest \
        --dscale=nearest \
        --no-osd-bar \
        --osc=no \
        --no-border \
        --stop-screensaver=no \
        --panscan=1.0 \
        --no-input-default-bindings \
        --wid=%WID \
        "$ANIMATED_WALLPAPER" \
    >>"$log_file" 2>&1 &
